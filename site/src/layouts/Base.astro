---
import '../styles/global.css';
// Shared page shell. Static site: no client JavaScript, no analytics, no
// external requests. Type is set large on purpose — the reader may be
// installing this for a parent, or may be the parent.
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL; // '/Phishing-Preventer-AI-Project/'
const repo = 'https://github.com/jaym267/Phishing-Preventer-AI-Project';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path === href.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`data:image/svg+xml,${encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><path d="M16 2 4 7v9c0 7 5 12 12 14 7-2 12-7 12-14V7z" fill="#2f5fd6"/><path d="M10 16l4 4 8-9" fill="none" stroke="#fff" stroke-width="3"/></svg>')}`} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header>
      <div class="wrap bar">
        <a class="brand" href={base}>
          <span class="mark" aria-hidden="true"></span>
          ScamShield Mail
        </a>
        <nav aria-label="Site">
          <a href={base} aria-current={isActive(base) ? 'page' : undefined}>About</a>
          <a href={`${base}install/`} aria-current={isActive(`${base}install/`) ? 'page' : undefined}>Install</a>
          <a href={repo} rel="noopener">Source</a>
        </nav>
      </div>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer class="wrap">
      <p>
        ScamShield Mail is a personal, open project — not a product, and not affiliated with Google or Anthropic.
        It never deletes email. Nothing on this page collects data.
      </p>
      <p><a href={repo} rel="noopener">Source on GitHub</a></p>
    </footer>
  </body>
</html>

